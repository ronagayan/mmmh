<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card_variant" android:padding="12dp" android:layout_marginBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/rec_type" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_primary" android:textColor="@color/on_primary" android:textSize="12sp" android:textStyle="bold"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
        <TextView android:id="@+id/rec_meta" style="@style/Caption" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/rec_body" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textIsSelectable="true" />
    <LinearLayout android:id="@+id/rec_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" />
</LinearLayout>
